# ScoutForge — .env example
# Copy values into your shell / process-supervisor environment (the app reads
# the process environment only — see docs/env-config.md). Never commit real
# values; this file documents the available knobs.
#
# Version: v0.1 · 15-11-26 · Author: SHIVAM ITCS (JARVIS)

# SQLite database file — the only variable the app itself reads (at import
# time, in backend/app/database.py). Default: backend/scoutforge.db relative
# to the backend/ working dir. Use an absolute path on persistent storage
# in production.
SCOUTFORGE_DB=./scoutforge.db

# ASGI server bind — supervisor/CLI conventions, not read by the app itself
# (uvicorn --host/--port/--workers flags take precedence when passed
# explicitly — see docs/RUNNING.md and docs/DEPLOYMENT.md).
# SCOUTFORGE_HOST=0.0.0.0
# SCOUTFORGE_PORT=8000
# SCOUTFORGE_WORKERS=1   # keep 1 with a single SQLite file (one writer at a time)
